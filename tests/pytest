import pytest
from cloakbrowser import launch

@pytest.fixture(scope="module")
def cloak_browser():
    """
    Phase 1: CloakBrowserの起動フィクスチャ
    ※ 初回実行時は専用Chromiumバイナリの自動ダウンロードが行われます。
    """
    # ブラウザの起動（Phase 1の初期テストは headless=True でOK）
    browser = launch(headless=True)
    yield browser
    # テスト完了後のクリーンアップ処理
    browser.close()

def test_browser_launch_and_navigation(cloak_browser):
    """
    テスト1: 正常に起動し、ページが開いてHTTP 200レスポンスとタイトルが取得できるか検証
    """
    page = cloak_browser.new_page()
    
    # 軽量なテストページへアクセス
    response = page.goto("https://example.com", wait_until="domcontentloaded")
    
    # アサーション（検証）
    assert response is not None, "レスポンスの取得に失敗しました"
    assert response.status == 200, f"ステータスコード異常: {response.status}"
    assert "Example Domain" in page.title(), "ページタイトルの取得に失敗しました"
    
    page.close()

def test_browser_eval_javascript(cloak_browser):
    """
    テスト2: JavaScript実行エンジンが正しく応答するか検証
    """
    page = cloak_browser.new_page()
    page.goto("about:blank")
    
    # 簡易JS実行テスト
    user_agent = page.evaluate("navigator.userAgent")
    assert "Mozilla" in user_agent, f"不正なUser-Agent: {user_agent}"
    
    page.close()
