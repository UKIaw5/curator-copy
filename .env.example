# Ollamaモデル指定(任意、未設定ならコード内デフォルト値を使用)
# 注意: QWEN_MODELはcurator.py/generate_x_posts.py/refiner.pyの補助呼び出しで
# 共有されるため、変更すると複数箇所に影響します(詳細はCLAUDE.md 4章参照)
QWEN_MODEL=qwen3.8:27b
GEMMA_MODEL=gemma4:12b
GEMMA_REVIEWER_MODEL=gemma4:12b

# 認証情報は環境変数ではなくcookieファイルで管理します(DISCORD_WEBHOOK_URL以外)。
# 取得方法はCLAUDE.md 6章を参照してください:
#   - cookies.json (X用、旧経路、現在未使用)
#   - for-note-post/note_cookies.json (note.com用)
#   - automation/socialdog_cookies.json (SocialDog用、現在の本番経路)

# scripts/notify_daily_result.py が日次実行結果を投稿するDiscord Webhook URL
# (Discordのチャンネル設定 → 連携を編集 → Webhook → 新しいWebhook で発行)
DISCORD_WEBHOOK_URL=
